{
  "name": "@alfianrafli/growtopia.wasm",
  "version": "0.2.1",
  "description": "A Universal Growtopia ENet WASM for Node.js, Bun.js (replacement for growtopia.js)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node-transport.d.ts",
      "import": "./dist/node-transport.mjs",
      "require": "./dist/node-transport.js"
    },
    "./browser": {
      "types": "./dist/browser-transport.d.ts",
      "import": "./dist/browser-transport.mjs",
      "require": "./dist/browser-transport.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "ava": {
    "files": [
      "__test__/**/*"
    ],
    "extensions": [
      "cjs",
      "mjs"
    ],
    "timeout": "3m",
    "serial": true
  },
  "engines": {
    "node": ">= 10"
  },
  "homepage": "https://github.com/AlfianRafli/growtopia.wasm-ng#readme",
  "bugs": {
    "url": "https://github.com/AlfianRafli/growtopia.wasm-ng/issues"
  },
  "repository": "https://github.com/AlfianRafli/growtopia.wasm-ng",
  "keywords": [
    "growtopia",
    "rust",
    "wasm",
    "webassembly",
    "enet",
    "udp"
  ],
  "author": {
    "name": "StileDevs",
    "email": "hendra@jad.li",
    "url": "https://stile.jad.li"
  },
  "scripts": {
    "build:wasm": "rimraf lib/pkg && wasm-pack build --target web --out-dir lib/pkg",
    "build:tsup": "rimraf dist && tsup && tsc --emitDeclarationOnly --outDir dist",
    "build": "bun run build:wasm && bun run build:tsup",
    "test": "ava",
    "docs": "rimraf docs && typedoc",
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "ava": "^8.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "rimraf": "^6.1.3",
    "selfsigned": "^5.5.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "5.6.3",
    "wasm-pack": "^0.15.0"
  },
  "dependencies": {
    "nanoevents": "^10.0.0"
  }
}
